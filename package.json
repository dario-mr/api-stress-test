{
  "name": "api-stress-test",
  "productName": "API Stress Test",
  "version": "1.0.0",
  "main": "electron/main.cjs",
  "scripts": {
    "prepare-jar": "mvn clean package && cp target/*.jar electron/app.jar",
    "start": "electron .",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.dario.ast",
    "files": [
      "electron/main.cjs",
      "electron/icon.icns"
    ],
    "extraResources": [
      {
        "from": "electron/app.jar",
        "to": "electron/app.jar"
      },
      {
        "from": "electron/jre",
        "to": "electron/jre"
      },
      {
        "from": "electron/splash.html",
        "to": "electron/splash.html"
      },
      {
        "from": "electron/logo.png",
        "to": "electron/logo.png"
      }
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": "dmg",
      "icon": "electron/icon.icns",
      "identity": null,
      "entitlements": "entitlements.mac.plist",
      "extendInfo": {
        "CFBundleDisplayName": "API Stress Test",
        "CFBundleName": "API Stress Test"
      }
    }
  },
  "license": "UNLICENSED",
